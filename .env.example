# Copy to .env and fill in. All keys are free to obtain.

# https://fred.stlouisfed.org/docs/api/api_key.html  (free, instant)
FRED_API_KEY=

# https://finnhub.io/  -> Dashboard -> API key  (free tier: 60 calls/min)
FINNHUB_API_KEY=

# SEC requires a descriptive User-Agent on every EDGAR request.
# Format: "Sample Company Name AdminContact@example.com"
SEC_USER_AGENT=stock_v3 research-tool contact@example.com

# Optional. Only needed for `analyze TICKER --narrative`.
# Without it the report still generates with deterministic templated prose.
ANTHROPIC_API_KEY=
