<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark light">
<title>{{ r.quote.ticker }} — Institutional Research</title>
<style>
{{ axis_css | safe }}

/* ---- report layout (AXIS, mobile-first) ---- */
body { padding: 0; }  /* glass material supplies the gradient backdrop */
.wrap { max-width: 880px; margin: 0 auto; padding: clamp(16px, 4vw, 40px) clamp(14px, 4vw, 28px) 80px; }
.report-card { margin: 14px 0; padding: clamp(18px, 4vw, 26px); }
section { scroll-margin-top: 16px; }

h2.sec { font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: var(--tracking-label);
  color: var(--text-tertiary); font-weight: 600; margin: 0 0 14px; }

/* masthead */
.masthead { display: flex; justify-content: space-between; align-items: flex-start;
  gap: 20px; flex-wrap: wrap; padding-top: 8px; }
.masthead h1 { font-size: clamp(28px, 7vw, 38px); letter-spacing: -0.02em;
  font-family: var(--font-sans); }
.masthead .co { color: var(--text-secondary); font-size: var(--fs-h3); margin-top: 4px; }
.masthead .meta { color: var(--text-tertiary); font-size: var(--fs-sm); margin-top: 8px; }
.masthead .px { text-align: right; }
.masthead .px .val { font-size: clamp(26px, 7vw, 34px); font-weight: 700;
  font-family: var(--font-mono); font-variant-numeric: tabular-nums; color: var(--text-primary); }
.masthead .px .lbl { color: var(--text-tertiary); font-size: var(--fs-xs); margin-top: 2px; }

/* verdict hero */
.hero { display: grid; grid-template-columns: 200px 1fr; gap: 26px; align-items: center; }
.hero .lede { font-size: clamp(16px, 4vw, 18px); line-height: 1.55; color: var(--text-primary); }
.hero .conf { color: var(--text-secondary); font-size: var(--fs-sm); margin-top: 12px; }
.hero .conf strong { color: var(--text-primary); font-family: var(--font-mono); }
.gauge-wrap { text-align: center; }
.gauge-wrap .verdict { margin-top: 8px; }

/* stat grid */
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 1px; background: var(--border-subtle); border-radius: var(--radius-md); overflow: hidden; }
.stat { background: var(--bg-elevated); padding: 14px 16px; }
.stat .k { color: var(--text-tertiary); font-size: var(--fs-micro); text-transform: uppercase;
  letter-spacing: 0.04em; }
.stat .v { font-size: var(--fs-h3); font-weight: 600; margin-top: 4px;
  font-family: var(--font-mono); font-variant-numeric: tabular-nums; }

/* key-value rows */
.kv { display: grid; grid-template-columns: 1fr auto; }
.kv .row { display: contents; }
.kv .row > * { padding: 10px 0; border-bottom: 1px solid var(--border-subtle); }
.kv .row:last-child > * { border-bottom: none; }
.kv .key { color: var(--text-secondary); font-size: var(--fs-sm); }
.kv .val { text-align: right; font-weight: 500; font-family: var(--font-mono);
  font-variant-numeric: tabular-nums; font-size: var(--fs-sm); }
.kv .val.text { font-family: var(--font-sans); }

/* coverage table */
.cov { width: 100%; border-collapse: collapse; font-size: var(--fs-sm); }
.cov th { text-align: left; color: var(--text-tertiary); font-weight: 600; padding: 7px 10px;
  border-bottom: 1px solid var(--border-default); font-size: var(--fs-micro);
  text-transform: uppercase; letter-spacing: 0.04em; }
.cov td { padding: 9px 10px; border-bottom: 1px solid var(--border-subtle); }
.cov td.mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.cov tr:last-child td { border-bottom: none; }
.src-note { font-size: var(--fs-xs); color: var(--text-muted); margin-top: 10px; line-height: 1.5; }

/* scenarios */
.scen { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 14px; }
.scen .s { border-radius: var(--radius-md); padding: 16px; background: var(--bg-inset);
  border: 1px solid var(--border-subtle); }
.scen .s .name { font-weight: 600; font-size: var(--fs-sm); }
.scen .s .pt { font-size: clamp(20px, 5vw, 24px); font-weight: 700; margin: 6px 0 2px;
  font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.scen .s .pr { color: var(--text-tertiary); font-size: var(--fs-xs);
  font-family: var(--font-mono); }
.scen .s .dr { font-size: var(--fs-xs); color: var(--text-secondary); margin-top: 8px; line-height: 1.45; }
.scen .bull { box-shadow: inset 3px 0 0 var(--positive); }
.scen .base { box-shadow: inset 3px 0 0 var(--accent); }
.scen .bear { box-shadow: inset 3px 0 0 var(--critical); }

/* probability cone calculator */
.cone-chart-wrap { margin: 4px 0 18px; }
.cone-legend { display: flex; gap: 16px; flex-wrap: wrap; font-size: var(--fs-xs);
  color: var(--text-tertiary); margin-bottom: 6px; }
.cone-legend .sw { display: inline-block; width: 18px; height: 8px; border-radius: 3px;
  vertical-align: middle; margin-right: 5px; }
.cone-calc { background: var(--bg-inset); border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md); padding: 18px; }
.cone-calc-head { display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 14px; gap: 12px; flex-wrap: wrap; }
.cone-vol { font-size: var(--fs-xs); color: var(--text-tertiary); }
.cone-horizons { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
.cone-htab { height: 40px; padding: 0 18px; border-radius: var(--radius-pill);
  background: var(--bg-elevated); border: 1px solid var(--border-default);
  color: var(--text-secondary); font-family: var(--font-sans); font-size: var(--fs-sm);
  font-weight: 600; cursor: pointer; transition: all var(--dur) var(--ease-out); }
.cone-htab:hover { border-color: var(--border-strong); color: var(--text-primary); }
.cone-htab.active { background: var(--accent); color: var(--accent-text); border-color: transparent; }
.cone-target { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px; }
.cone-label { color: var(--text-secondary); font-size: var(--fs-sm); }
.cone-price { font-size: clamp(22px, 6vw, 28px); font-weight: 700; color: var(--text-primary); }
.cone-probs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 20px; }
.cone-prob { text-align: center; padding: 14px 8px; background: var(--bg-elevated);
  border-radius: var(--radius-md); border: 1px solid var(--border-subtle); }
.cone-prob-val { font-size: clamp(22px, 6vw, 28px); font-weight: 700; }
.cone-prob.up .cone-prob-val { color: var(--positive); }
.cone-prob.down .cone-prob-val { color: var(--critical); }
.cone-prob-lbl { font-size: var(--fs-xs); color: var(--text-tertiary); margin-top: 4px; }

/* risks + catalysts */
ul.risks { margin: 0; padding-left: 20px; }
ul.risks li { margin: 7px 0; line-height: 1.5; font-size: var(--fs-sm); color: var(--text-primary); }
.cat-ev { display: grid; grid-template-columns: 96px 1fr auto; gap: 12px; font-size: var(--fs-sm);
  padding: 10px 0; border-bottom: 1px solid var(--border-subtle); align-items: baseline; }
.cat-ev:last-child { border-bottom: none; }
.cat-ev .d { color: var(--text-tertiary); font-family: var(--font-mono);
  font-variant-numeric: tabular-nums; font-size: var(--fs-xs); }

/* trade plan */
.plan { font-family: var(--font-mono); font-size: var(--fs-sm);
  background: var(--bg-base); color: var(--text-primary); border: 1px solid var(--border-default);
  border-radius: var(--radius-md); padding: 20px 22px; overflow-x: auto; line-height: 1.75;
  white-space: pre; font-variant-numeric: tabular-nums; }
.plan .pk { color: var(--text-tertiary); } .plan .pv { color: var(--text-primary); font-weight: 600; }
.plan .accent { color: var(--accent-hover); }

/* scorecard list */
ul.cat { list-style: none; margin: 14px 0 0; padding: 0; }
ul.cat li { display: grid; grid-template-columns: 160px 1fr auto; gap: 14px; padding: 11px 0;
  border-bottom: 1px solid var(--border-subtle); font-size: var(--fs-sm); line-height: 1.45;
  align-items: baseline; }
ul.cat li:last-child { border-bottom: none; }
ul.cat .nm { font-weight: 600; color: var(--text-primary); }
ul.cat .rt { color: var(--text-secondary); }
ul.cat .sc { font-family: var(--font-mono); font-weight: 600; font-variant-numeric: tabular-nums;
  color: var(--text-primary); }

.est-tag { font-size: var(--fs-micro); color: var(--warning); font-weight: 600; vertical-align: super; }
.disclaimer { font-size: var(--fs-xs); color: var(--text-muted); margin-top: 28px; line-height: 1.55;
  text-align: center; }

@media (max-width: 620px) {
  .hero { grid-template-columns: 1fr; gap: 16px; }
  .scen { grid-template-columns: 1fr; }
  .masthead .px { text-align: left; }
  ul.cat li { grid-template-columns: 1fr; gap: 2px; }
  ul.cat .sc { justify-self: start; }
  .cat-ev { grid-template-columns: 80px 1fr auto; }
}
@media print {
  body { background: #fff; }
  .report-card { box-shadow: none; border: 1px solid var(--border-default); break-inside: avoid; }
  .cone-calc, .cone-htab { display: none !important; }
}
</style>
</head>
<body class="glass">
<div class="wrap">

  <header class="masthead">
    <div class="id">
      <h1>{{ r.quote.ticker }}</h1>
      <div class="co">{{ r.quote.company }}</div>
      <div class="meta">
        {{ r.quote.sector or "—" }}{% if r.quote.industry %} · {{ r.quote.industry }}{% endif %}
        {% if r.quote.market_cap %} · {{ fmt_big(r.quote.market_cap) }} mkt cap{% endif %}
        {% if r.quote.exchange %} · {{ r.quote.exchange }}{% endif %}
      </div>
    </div>
    <div class="px">
      <div class="val">{{ fmt_money(r.quote.price) }}</div>
      <div class="lbl">{{ r.quote.currency }} · delayed · {{ r.generated_at.strftime("%Y-%m-%d %H:%M") }}</div>
    </div>
  </header>

  <section class="axis-card report-card" id="summary">
    <div class="hero">
      <div class="gauge-wrap">
        {{ gauge_svg | safe }}
        <div><span class="verdict {{ verdict_class }}">{{ r.verdict.label }}</span></div>
      </div>
      <div>
        <p class="lede">{{ r.narrative.executive_summary }}</p>
        <div class="conf">
          Confidence <strong>{{ r.verdict.confidence }}</strong>/100 · {{ r.verdict.confidence_band }}
          · Macro: <strong>{{ r.macro_regime.value }}</strong>
          {% if narrative_source == "deterministic-template" %}
          · <span style="color:var(--warning)">narrative: deterministic template (no LLM)</span>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <div class="axis-card report-card">
    <div class="stats">
      {% for k, v in headline_stats %}
      <div class="stat"><div class="k">{{ k }}</div><div class="v">{{ v }}</div></div>
      {% endfor %}
    </div>
  </div>

  <section class="axis-card report-card" id="coverage">
    <h2 class="sec">Data Coverage &amp; Freshness</h2>
    <table class="cov">
      <thead><tr><th>Layer</th><th>Source</th><th>Status</th><th>As of</th><th>Notes</th></tr></thead>
      <tbody>
      {% for c in r.coverage %}
        <tr>
          <td>{{ c.layer }}</td><td>{{ c.source }}</td>
          <td><span class="pill s-{{ c.status }}">{{ c.status }}</span></td>
          <td class="mono">{{ c.as_of }}</td>
          <td style="color:var(--text-tertiary)">{{ c.note or "—" }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    <p class="src-note">Free-data tool. Prices/quotes delayed. 13F ownership lags ~45 days;
    short interest is the bi-monthly FINRA settlement. Borrow rates and authoritative dealer
    gamma are not available on free data and are marked N/A or shown as estimates.</p>
  </section>

  <section class="axis-card report-card" id="macro">
    <h2 class="sec">Macro Environment</h2>
    {% if r.macro %}
    <div class="kv">
      <div class="row"><span class="key">US 2Y / 10Y</span><span class="val">{{ fmt_pct_raw(r.macro.ust_2y) }} / {{ fmt_pct_raw(r.macro.ust_10y) }}</span></div>
      <div class="row"><span class="key">Yield curve (10Y–2Y)</span><span class="val {{ 'delta-down' if (r.macro.yield_curve_10y_2y or 0) < 0 else '' }}">{{ fmt_pct_raw(r.macro.yield_curve_10y_2y) }}pp</span></div>
      <div class="row"><span class="key">CPI / Core CPI (YoY)</span><span class="val">{{ fmt_pct(r.macro.cpi_yoy) }} / {{ fmt_pct(r.macro.core_cpi_yoy) }}</span></div>
      <div class="row"><span class="key">VIX</span><span class="val">{{ fmt_n(r.macro.vix) }}</span></div>
      <div class="row"><span class="key">Dollar (DXY trend 3m)</span><span class="val">{{ fmt_pct(r.macro.dxy_trend_3m) }}</span></div>
    </div>
    <p style="margin-top:12px;color:var(--text-secondary);font-size:var(--fs-sm)">{{ macro_rationale }}</p>
    {% else %}
    <p style="color:var(--text-tertiary)">Macro layer unavailable (no FRED key). Scorecard category neutralized.</p>
    {% endif %}
  </section>

  <section class="axis-card report-card" id="positioning">
    <h2 class="sec">Institutional Positioning</h2>
    {% if r.positioning %}
    <div class="kv">
      <div class="row"><span class="key">Institutional stance</span><span class="val text">{{ positioning_stance }}</span></div>
      <div class="row"><span class="key">Top holders reported</span><span class="val">{{ r.positioning.institutional_holders | length }}</span></div>
      <div class="row"><span class="key">Insider flow (90d)</span><span class="val text">{{ insider_signal }}</span></div>
      <div class="row"><span class="key">Short interest (% float)</span><span class="val">{{ fmt_pct(r.positioning.short_interest_pct_float) }}</span></div>
      <div class="row"><span class="key">Days to cover</span><span class="val">{{ fmt_n(r.positioning.days_to_cover) }}</span></div>
      <div class="row"><span class="key">Borrow rate</span><span class="val" style="color:var(--text-muted)">N/A (free data)</span></div>
    </div>
    {% if r.options %}
    <div style="margin-top:16px">
      <h2 class="sec">Options Positioning <span class="est-tag">estimate</span></h2>
      <div class="kv">
        <div class="row"><span class="key">Put/Call (OI)</span><span class="val">{{ fmt_n(r.options.put_call_ratio) }}</span></div>
        <div class="row"><span class="key">ATM implied vol</span><span class="val">{{ fmt_pct(r.options.atm_iv) }}</span></div>
        <div class="row"><span class="key">Call wall</span><span class="val">{{ fmt_money(r.options.call_wall) }}</span></div>
        <div class="row"><span class="key">Put wall</span><span class="val">{{ fmt_money(r.options.put_wall) }}</span></div>
        <div class="row"><span class="key">Est. gamma flip</span><span class="val">{{ fmt_money(r.options.gamma_flip) }}</span></div>
      </div>
    </div>
    {% endif %}
    {% else %}
    <p style="color:var(--text-tertiary)">Positioning data unavailable.</p>
    {% endif %}
  </section>

  <section class="axis-card report-card" id="fundamentals">
    <h2 class="sec">Fundamental Analysis</h2>
    {% if r.fundamentals %}
    <div class="kv">
      <div class="row"><span class="key">Revenue growth (YoY)</span><span class="val">{{ fmt_pct(r.fundamentals.revenue_growth_yoy) }}</span></div>
      <div class="row"><span class="key">Gross / Operating margin</span><span class="val">{{ fmt_pct(r.fundamentals.gross_margin) }} / {{ fmt_pct(r.fundamentals.operating_margin) }}</span></div>
      <div class="row"><span class="key">Net / FCF margin</span><span class="val">{{ fmt_pct(r.fundamentals.net_margin) }} / {{ fmt_pct(r.fundamentals.fcf_margin) }}</span></div>
      <div class="row"><span class="key">Net debt</span><span class="val">{{ fmt_big_signed(r.fundamentals.net_debt) }}</span></div>
      <div class="row"><span class="key">Current ratio</span><span class="val">{{ fmt_n(r.fundamentals.current_ratio) }}</span></div>
    </div>
    <p style="margin-top:12px;color:var(--text-secondary);font-size:var(--fs-sm)">{{ fundamentals_rationale }}</p>
    {% else %}<p style="color:var(--text-tertiary)">Fundamentals unavailable.</p>{% endif %}
  </section>

  <section class="axis-card report-card" id="valuation">
    <h2 class="sec">Valuation Analysis</h2>
    {% if r.fundamentals %}
    <div class="kv">
      <div class="row"><span class="key">P/E (trailing / forward)</span><span class="val">{{ fmt_n(r.fundamentals.pe) }} / {{ fmt_n(r.fundamentals.forward_pe) }}</span></div>
      <div class="row"><span class="key">EV/EBITDA</span><span class="val">{{ fmt_n(r.fundamentals.ev_ebitda) }}</span></div>
      <div class="row"><span class="key">Price/Sales</span><span class="val">{{ fmt_n(r.fundamentals.price_to_sales) }}</span></div>
      <div class="row"><span class="key">PEG</span><span class="val">{{ fmt_n(r.fundamentals.peg) }}</span></div>
      <div class="row"><span class="key">Price/FCF</span><span class="val">{{ fmt_n(r.fundamentals.price_to_fcf) }}</span></div>
    </div>
    <p style="margin-top:12px;color:var(--text-secondary);font-size:var(--fs-sm)">{{ valuation_rationale }}</p>
    {% endif %}
    {% if r.consensus and r.consensus.target_mean %}
    <div style="margin-top:16px">
      <h2 class="sec">Analyst Consensus</h2>
      <div class="kv">
        <div class="row"><span class="key">Rating</span><span class="val text">{{ r.consensus.rating or "—" }} ({{ r.consensus.num_analysts or "?" }})</span></div>
        <div class="row"><span class="key">Target (mean)</span><span class="val">{{ fmt_money(r.consensus.target_mean) }}</span></div>
        <div class="row"><span class="key">Target range</span><span class="val">{{ fmt_money(r.consensus.target_low) }} – {{ fmt_money(r.consensus.target_high) }}</span></div>
      </div>
    </div>
    {% endif %}
  </section>

  <section class="axis-card report-card" id="technicals">
    <h2 class="sec">Technical Analysis</h2>
    {% if price_chart_svg %}{{ price_chart_svg | safe }}{% endif %}
    {% if r.technicals %}
    <div class="kv" style="margin-top:14px">
      <div class="row"><span class="key">Trend</span><span class="val text">{{ technical_trend }}</span></div>
      <div class="row"><span class="key">8 / 21 EMA</span><span class="val">{{ fmt_money(r.technicals.ema_8) }} / {{ fmt_money(r.technicals.ema_21) }}</span></div>
      <div class="row"><span class="key">50 / 200 SMA</span><span class="val">{{ fmt_money(r.technicals.sma_50) }} / {{ fmt_money(r.technicals.sma_200) }}</span></div>
      <div class="row"><span class="key">RSI (14)</span><span class="val">{{ fmt_n(r.technicals.rsi_14) }}</span></div>
      <div class="row"><span class="key">MACD</span><span class="val">{{ fmt_n(r.technicals.macd) }} (sig {{ fmt_n(r.technicals.macd_signal) }})</span></div>
      <div class="row"><span class="key">ATR (14)</span><span class="val">{{ fmt_n(r.technicals.atr_14) }}</span></div>
    </div>
    <p style="margin-top:12px;color:var(--text-secondary);font-size:var(--fs-sm)">{{ technical_rationale }}</p>
    {% endif %}
  </section>

  <section class="axis-card report-card" id="catalysts">
    <h2 class="sec">Upcoming Catalysts</h2>
    {% if r.catalysts %}
      {% for c in r.catalysts %}
      <div class="cat-ev">
        <span class="d">{{ c.date.isoformat() if c.date else "TBD" }}</span>
        <span>{{ c.label }}</span>
        <span class="pill {{ 'crit' if c.importance == 'high' else 'warn' if c.importance == 'medium' else 'muted' }}">{{ c.importance }}</span>
      </div>
      {% endfor %}
    {% else %}<p style="color:var(--text-tertiary)">No catalysts in the next 90 days.</p>{% endif %}
  </section>

  <section class="axis-card report-card" id="risks">
    <h2 class="sec">Key Risks</h2>
    <ul class="risks">{% for risk in r.key_risks %}<li>{{ risk }}</li>{% endfor %}</ul>
    {% if r.narrative.risks %}<p style="margin-top:10px;color:var(--text-secondary);font-size:var(--fs-sm)">{{ r.narrative.risks }}</p>{% endif %}
  </section>

  <section class="axis-card report-card" id="scenarios">
    <h2 class="sec">Scenario Analysis &amp; Probability Cone</h2>
    {% if has_cone %}
    <div class="cone-legend">
      <span><span class="sw" style="background:color-mix(in oklab,var(--accent) 16%,transparent)"></span>±1σ (68%)</span>
      <span><span class="sw" style="background:color-mix(in oklab,var(--accent) 8%,transparent)"></span>±2σ (95%)</span>
      <span><span class="sw" style="background:var(--positive)"></span>Bull</span>
      <span><span class="sw" style="background:var(--accent)"></span>Base</span>
      <span><span class="sw" style="background:var(--critical)"></span>Bear</span>
    </div>
    <div class="cone-chart-wrap">{{ cone_svg | safe }}</div>
    {% else %}
    {{ scenario_svg | safe }}
    {% endif %}

    <div class="scen">
      {% for s in r.scenarios %}
      <div class="s {{ s.name | lower }}">
        <div class="name">{{ s.name }} Case</div>
        <div class="pt">{{ fmt_money(s.price_target) }}</div>
        <div class="pr">{{ (s.probability * 100) | round | int }}% probability</div>
        <div class="dr">{{ s.drivers }}</div>
      </div>
      {% endfor %}
    </div>

    {% if cone_widget %}
    <div style="margin-top:18px">{{ cone_widget | safe }}</div>
    <p class="src-note">Probability cone uses the {{ r.probability_cone.vol_source }} volatility
    estimate ({{ fmt_pct(r.probability_cone.annual_vol) }} annualized) and a zero-drift lognormal
    model — the thinkorswim/Schwab standard (±1σ ≈ 68%). It maps dispersion, not a directional forecast.</p>
    {% endif %}
  </section>

  <section class="axis-card report-card" id="tradeplan">
    <h2 class="sec">Trade Plan &amp; Position Sizing</h2>
    {% if r.narrative.portfolio_impact %}<p style="color:var(--text-secondary);font-size:var(--fs-sm);margin-bottom:14px">{{ r.narrative.portfolio_impact }}</p>{% endif %}
    <div class="plan">{{ trade_plan_block | safe }}</div>
  </section>

  <section class="axis-card report-card" id="scorecard">
    <h2 class="sec">Institutional Scorecard</h2>
    {{ scorecard_svg | safe }}
    <ul class="cat">
      {% for cat in r.scorecard %}
      <li><span class="nm">{{ cat.name }}</span><span class="rt">{{ cat.rationale }}</span><span class="sc">{{ cat.score }}/10</span></li>
      {% endfor %}
    </ul>
  </section>

  <section class="axis-card report-card" id="verdict">
    <h2 class="sec">Final Verdict</h2>
    <div class="hero">
      <div class="gauge-wrap">
        <span class="verdict {{ verdict_class }}" style="font-size:var(--fs-h3)">{{ r.verdict.label }}</span>
        <div style="font-family:var(--font-mono);font-size:var(--fs-xs);color:var(--text-tertiary);margin-top:8px">
          Conviction {{ r.verdict.conviction_score }}/100</div>
      </div>
      <div><p class="lede">{{ r.narrative.thesis }}</p></div>
    </div>
  </section>

  <p class="disclaimer">
    Generated by stock_v3 on {{ r.generated_at.strftime("%Y-%m-%d %H:%M") }} from free, delayed
    data. Structured research output — not financial advice, a recommendation, or a solicitation.
    Verify all figures independently before acting.
  </p>

</div>
</body>
</html>
